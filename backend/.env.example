# ---- 必填 ----
# 签名用的私钥（对应链上合约的 admin 地址）
PRIVATE_KEY=

# ---- 可选（POST /sign 请求里也可以传，请求值优先）----
# 部署合约的链 ID
CHAIN_ID=11155111
# 部署的合约地址
CONTRACT_ADDRESS=0x4E8899a51bb8C66F89f2899E440e78C8be9dD1a8

# ---- 可选：EIP-712 合约专用配置（留空则回退到上面普通版的配置）----
# 712 合约地址（留空则用 CONTRACT_ADDRESS）
CONTRACT_ADDRESS_712=0x8dA82B3957b86EeF7C0afAE78D9F46D33f7c6F1e
# 712 签名私钥（留空则用 PRIVATE_KEY）
PRIVATE_KEY_712=
# 服务端口
PORT=8080
